# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cybermentor:changeme@localhost:5432/cybermentor_db
DATABASE_URL_SYNC=postgresql://cybermentor:changeme@localhost:5432/cybermentor_db

# ── Security ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

# ── AI Provider ───────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
AI_MODEL=claude-3-5-haiku-20241022
AI_MAX_TOKENS=1024
# Mentor CANNOT award XP, change grades, or modify roles — enforced server-side

# ── App ───────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Rate limits ───────────────────────────────────────────
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=20/minute
